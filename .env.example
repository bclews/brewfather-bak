# Brewfather API credentials — copy to `.env` and fill in.
# Generate an API key in Brewfather: Settings -> API (needs read scopes for
# recipes, batches, and inventory).
BREWFATHER_USER_ID=your-user-id
BREWFATHER_API_KEY=your-api-key

# Optional overrides (defaults shown):
# BREWFATHER_BASE_URL=https://api.brewfather.app/v2
# BREWFATHER_OUTPUT_DIR=./backups
# BREWFATHER_REQUEST_TIMEOUT=30
